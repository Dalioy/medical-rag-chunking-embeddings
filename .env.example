# Copy this file to `.env` (or export these in your shell) before running the pipeline.
# .env itself is git-ignored — never commit real API keys.

# Required for the embedding step (combined_cross_embed_pipeline.py)
GEMINI_API_KEY=your-gemini-api-key-here

# Optional — override where the local embedded Qdrant store is persisted.
# Defaults to ./qdrantdb (relative to wherever the script is run from).
# QDRANT_PATH=./qdrantdb
